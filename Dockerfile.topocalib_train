# docker run -it --rm --gpus all --name topocalib_train topocalib_train:1.0

FROM pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/workspace/TopoCalib-UC:/workspace/TopoCalib-UC/baselines/external/sDbscan

SHELL ["/bin/bash", "-lc"]

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       build-essential \
       ca-certificates \
       libeigen3-dev \
    && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --no-cache-dir \
    numpy==1.26.4 \
    h5py==3.12.1 \
    pybind11==2.13.6

WORKDIR /workspace/TopoCalib-UC
COPY . /workspace/TopoCalib-UC

# Build the optional sDBSCAN extension after entering the image:
# cd baselines/external/sDbscan && python setup.py build_ext --inplace

CMD ["/bin/bash"]
